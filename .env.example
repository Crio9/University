APP_NAME="University Service"
DEBUG=true

POSTGRES_USER=uni
POSTGRES_PASSWORD=uni
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=uni_service

DATABASE_URL=postgresql+asyncpg://uni:uni@localhost:5432/uni_service
ALEMBIC_DATABASE_URL=postgresql+psycopg2://uni:uni@localhost:5432/uni_service

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_TIMEOUT_SECONDS=30
NVIDIA_MAX_RETRIES=2
AI_PROCESSING_CONCURRENCY=3
