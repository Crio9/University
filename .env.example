APP_NAME="uni-personal"
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

# Sync (psycopg2) URL used by the app and Alembic.
DATABASE_URL=postgresql+psycopg2://uni:uni@localhost:5432/uni_personal
# Optional: override just for migrations.
# ALEMBIC_DATABASE_URL=postgresql+psycopg2://uni:uni@localhost:5432/uni_personal

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
